# Keep text files consistent across Windows, macOS, and Linux.
* text=auto eol=lf

# Repository text formats.
*.cff text eol=lf
*.csv text eol=lf
*.drawio text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Do not normalise binary assets.
*.docx binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary
